# MediaHub — конфигурация. Скопируйте файл в .env и измените значения.
# Переменные читаются при старте сервера (mediahub/config.py).

# --- Сеть ---------------------------------------------------------------
MEDIAHUB_HOST=0.0.0.0
MEDIAHUB_PORT=8765
# Принудительный адрес для QR-ссылок (если автоопределение ошибается):
# MEDIAHUB_PUBLIC_HOST=192.168.1.50

# --- Хранилище и жизненный цикл сессий (ТЗ 2) ---------------------------
# MEDIAHUB_STORAGE_DIR=./storage/tasks
MEDIAHUB_TASK_TTL=1800
MEDIAHUB_GC_INTERVAL=300
MEDIAHUB_BURN_AFTER_DOWNLOAD=false
MEDIAHUB_BURN_DELAY=60

# --- Лимиты входных данных ---------------------------------------------
MEDIAHUB_MAX_FILES=50
MEDIAHUB_MAX_REQUEST_BYTES=209715200
MEDIAHUB_MAX_PDF_MERGE=20

# --- Значения по умолчанию для конвертации ------------------------------
MEDIAHUB_IMAGE_QUALITY=85
MEDIAHUB_PDF_DPI=150
MEDIAHUB_GIF_FPS=12
MEDIAHUB_GIF_WIDTH=480
MEDIAHUB_GIF_SECONDS=15
MEDIAHUB_MP3_BITRATE=192
MEDIAHUB_VIDEO_CRF=27

# --- Безопасность и производительность ----------------------------------
# Жёсткий лимит времени на одну команду FFmpeg, секунды (ТЗ 6):
MEDIAHUB_FFMPEG_TIMEOUT=120
# Токен доступа; если задан, требуется в заголовке X-MediaHub-Token:
# MEDIAHUB_TOKEN=
# Разрешить обращения не из локальных сетей (по умолчанию запрещено):
MEDIAHUB_ALLOW_PUBLIC=false
MEDIAHUB_WORKERS=2
MEDIAHUB_LOG_LEVEL=INFO

# --- Горячая папка --------------------------------------------------------
# Всё, что попадает в эту папку, обрабатывается само: картинки -> WEBP, PDF -> сжатый PDF.
# Результаты – в «Готово», исходники – в «Обработано», сбои – в «Ошибки». Пусто = выключено.
# MEDIAHUB_WATCH_DIR=C:\Users\you\MediaHub-Inbox
# MEDIAHUB_WATCH_FORMAT=webp
# MEDIAHUB_WATCH_QUALITY=85
